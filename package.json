{
  "name": "@zenmanage/angular",
  "version": "0.1.0",
  "description": "Angular services, directives, and guards for Zenmanage feature flags",
  "keywords": [
    "angular",
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "experiments",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-angular#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-angular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-angular.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/router": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@zenmanage/sdk": "^3.0.1",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ng-packagr": "^20.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
