{
  "name": "@zenmanage/angular",
  "version": "1.0.0",
  "description": "Angular service, signals, structural directives, route guards and SSR support for Zenmanage feature flags",
  "keywords": [
    "angular",
    "angular-ssr",
    "signals",
    "structural-directives",
    "route-guards",
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "remote-config",
    "ab-testing",
    "experiments",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-angular#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-angular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-angular.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "clean": "rm -rf dist coverage",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs",
    "release": "changeset publish",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit -p tsconfig.test.json && ngc -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run test:smoke",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@zenmanage/sdk": "^3.5.1",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@changesets/cli": "^2.28.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@zenmanage/sdk": "^3.5.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^24.1.1",
    "ng-packagr": "^20.0.0",
    "prettier": "^3.3.3",
    "rxjs": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0",
    "zone.js": "^0.15.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/fesm2022/zenmanage-angular.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/zenmanage-angular.mjs"
    }
  },
  "sideEffects": false
}
